TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321
FLASK_DEBUG=false

# Glassnode free API key (registro gratis en glassnode.com/pricing)
# Necesario para el indicador CVDD (Fase 6)
GLASSNODE_API_KEY=tu_api_key_aqui

# FRED API key (gratis, registro en https://fred.stlouisfed.org/docs/api/api_key.html)
# Necesario para los recolectores de liquidity_index/ (M2, balance Fed, RRP, TGA, Treasury 10Y)
FRED_API_KEY=tu_api_key_aqui

# PostgreSQL local (Docker) para liquidity_index/
POSTGRES_USER=liquidity
POSTGRES_PASSWORD=liquidity
POSTGRES_DB=liquidity_index
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
